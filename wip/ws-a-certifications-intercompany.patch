+++ b/backend/tests/test_intercompany_companies.py
@@ -0,0 +1,114 @@
+"""Intercompany settlements reference companies by id (CEO 2026-10-23), not free-text names
+matched at read time -- where a typo silently moved money into "Group". New entries require both
+companies; old entries were linked once by exact name (data migration intercompany_company_links)
+and the ones no company matched raise a Finance task and can be linked from the screen."""
+from datetime import date
+
+import pytest
+from sqlalchemy.orm import Session
+
+from app.core.db_contract import _intercompany_company_links
+from app.models.intercompany_ledger import IntercompanySettlement
+from app.models.location import Location
+from app.models.task import Task
+from app.services import revenue_chain_service as chain
+from app.services.goal_tree_service import company_bu_actuals
+from tests.scope_fixtures import ApiClient, two_bu_world, uid
+
+
+@pytest.fixture
+def db(test_db_engine):
+    connection = test_db_engine.connect()
+    outer = connection.begin()
+    session = Session(bind=connection, join_transaction_mode="create_savepoint")
+    yield session
+    session.close()
+    outer.rollback()
+    connection.close()
+
+
+@pytest.fixture
+def w(db):
+    world = two_bu_world(db)
+    world.us = Location(tenant_id=1, name=f"BX-US {uid()}")
+    world.india = Location(tenant_id=1, name=f"BX-IN {uid()}")
+    db.add_all([world.us, world.india])
+    db.commit()
+    return world
+
+
+@pytest.fixture
+def api(db):
+    client = ApiClient(db)
+    yield client
+    client.close()
+
+
+def _record(api, w, **kw):
+    body = {"from_company_id": w.us.id, "to_company_id": w.india.id, "amount_usd_cents": 500_000,
+            "settlement_date": "2026-09-15", "reason": "Offshore delivery", **kw}
+    return api.post(w.org_user, "/api/v1/intercompany-settlements", json=body)
+
+
+def test_a_new_entry_requires_real_companies_and_takes_their_names(db, w, api):
+    res = _record(api, w)
+    assert res.status_code == 201, res.text
+    body = res.json()
+    assert (body["from_company_id"], body["to_company_id"]) == (w.us.id, w.india.id)
+    assert (body["from_entity"], body["to_entity"]) == (w.us.name, w.india.name)
+
+    assert _record(api, w, to_company_id="no-such-company").status_code == 400
+    assert _record(api, w, to_company_id=w.us.id).status_code == 400
+    missing = api.post(w.org_user, "/api/v1/intercompany-settlements",
+                       json={"from_entity": "BXUS", "to_entity": "BXIN", "amount_usd_cents": 1,
+                             "settlement_date": "2026-09-15", "reason": "old shape"})
+    assert missing.status_code == 422
+
+
+def test_net_position_is_by_company(db, w, api):
+    _record(api, w)
+    _record(api, w, from_company_id=w.india.id, to_company_id=w.us.id, amount_usd_cents=200_000)
+    india = api.get(w.org_user, f"/api/v1/intercompany-settlements/company/{w.india.id}/net-position").json()
+    assert india == {"company_id": w.india.id, "entity": w.india.name, "net_position_usd_cents": 300_000}
+    assert api.get(w.org_user, "/api/v1/intercompany-settlements/company/nope/net-position").status_code == 404
+
+
+def test_company_pnl_and_goal_tree_attribute_by_id_even_after_a_rename(db, w, api):
+    _record(api, w)
+    w.india.name = "Renamed India entity"
+    db.commit()
+    pnl = chain.pnl(db, start=date(2026, 9, 1), end=date(2026, 9, 30), tenant_id=1)
+    rows = {r["key"]: r for r in pnl["by_company"]}
+    assert rows[w.india.id]["intercompany_revenue_usd_cents"] == 500_000
+    assert rows[w.us.id]["intercompany_cost_usd_cents"] == 500_000
+    actuals, intercompany = company_bu_actuals(db, 1, 2026)
+    assert actuals[(w.india.id, None)]["revenue"] == 5_000
+    assert intercompany >= 5_000
+
+
+def test_old_entries_are_linked_by_exact_name_and_the_rest_raise_a_task(db, w):
+    exact = IntercompanySettlement(tenant_id=1, from_entity=f"  {w.us.name.upper()} ", to_entity=w.india.name,
+                                   amount_usd_cents=100, settlement_date=date(2026, 9, 1), reason="r")
+    typo = IntercompanySettlement(tenant_id=1, from_entity=w.us.name, to_entity="BX-INDIA-TYPO",
+                                  amount_usd_cents=200, settlement_date=date(2026, 9, 2), reason="r")
+    db.add_all([exact, typo])
+    db.flush()
+
+    linked = _intercompany_company_links(db)
+    assert linked >= 1
+    assert (exact.from_company_id, exact.to_company_id) == (w.us.id, w.india.id)
+    assert typo.from_company_id == w.us.id and typo.to_company_id is None
+    task = db.query(Task).filter(Task.title.like("Link % intercompany entr%")).order_by(Task.id.desc()).first()
+    assert task is not None and "BX-INDIA-TYPO" in task.description and task.link == "/pnl?view=operations"
+
+
+def test_an_unlinked_entry_can_be_linked_once(db, w, api):
+    old = IntercompanySettlement(tenant_id=1, from_entity="??", to_entity="??", amount_usd_cents=300,
+                                 settlement_date=date(2026, 9, 3), reason="r")
+    db.add(old)
+    db.commit()
+    url = f"/api/v1/intercompany-settlements/{old.id}/link-companies"
+    res = api.post(w.org_user, url, json={"from_company_id": w.us.id, "to_company_id": w.india.id})
+    assert res.status_code == 200 and res.json()["to_company_id"] == w.india.id
+    again = api.post(w.org_user, url, json={"from_company_id": w.india.id, "to_company_id": w.us.id})
+    assert again.status_code == 400  # a linked entry is never re-pointed
diff --git a/frontend/src/components/EmployeeCertifications.js b/frontend/src/components/EmployeeCertifications.js
new file mode 100644
index 00000000..1e9b7a17
--- /dev/null
+++ b/frontend/src/components/EmployeeCertifications.js
@@ -0,0 +1,255 @@
+// Certificates an employee holds (one record each: earned date, expiry, issuer, certificate
+// number). These records are the one truth the training and certification dashboards count.
+// The current Guidewire level is derived from them (the highest Guidewire certificate held,
+// active and not expired); only the target level is typed in here.
+import { useCallback, useEffect, useState } from "react";
+import { Award, Trash2, Pencil } from "lucide-react";
+import { Button } from "./ui";
+import {
+  addEmployeeCertificate,
+  deleteEmployeeCertificate,
+  getCertificationOptions,
+  listEmployeeCertificates,
+  updateEmployeeCertificate,
+  updateEmployeeCertifications,
+} from "../services/api/employees";
+import { confirmDialog } from "../utils/dialogs";
+
+const dateOnly = (value) => (value ? String(value).slice(0, 10) : "");
+const today = () => new Date().toISOString().slice(0, 10);
+const EMPTY_FORM = { certificationId: "", earnedDate: "", expiresDate: "", issuer: "", certNumber: "" };
+
+function CertificateRow({ record, statuses, employeeId, onChanged }) {
+  const [editing, setEditing] = useState(false);
+  const [status, setStatus] = useState(record.status);
+  const [expiresDate, setExpiresDate] = useState(dateOnly(record.expires_date));
+  const [error, setError] = useState("");
+  const expired = record.expires_date && dateOnly(record.expires_date) < today();
+
+  const save = async () => {
+    setError("");
+    try {
+      await updateEmployeeCertificate(employeeId, record.id, { status, expires_date: expiresDate || null });
+      setEditing(false);
+      onChanged();
+    } catch (err) {
+      setError(err.message || "Failed to save the certificate.");
+    }
+  };
+
+  const remove = async () => {
+    if (!(await confirmDialog(`Remove ${record.cert_name} from this employee?`))) return;
+    setError("");
+    try {
+      await deleteEmployeeCertificate(employeeId, record.id);
+      onChanged();
+    } catch (err) {
+      setError(err.message || "Failed to remove the certificate.");
+    }
+  };
+
+  return (
+    <div className="rounded border bg-gray-50 p-2 text-sm">
+      <div className="flex flex-wrap items-center justify-between gap-2">
+        <div>
+          <div className="font-semibold">
+            {record.cert_name}
+            {record.guidewire_level ? <span className="ml-2 text-xs text-gray-500">Guidewire {record.guidewire_level}</span> : null}
+          </div>
+          <div className="text-xs text-gray-600">
+            {record.status} · earned {dateOnly(record.earned_date)} ·{" "}
+            {record.expires_date ? (
+              <span className={expired ? "font-semibold text-rose-700" : ""}>
+                {expired ? "expired" : "expires"} {dateOnly(record.expires_date)}
+              </span>
+            ) : (
+              "no expiry"
+            )}
+            {record.issuer ? ` · ${record.issuer}` : ""}
+            {record.cert_number ? ` · #${record.cert_number}` : ""}
+          </div>
+        </div>
+        <div className="flex gap-1">
+          <Button variant="ghost" size="sm" onClick={() => setEditing((v) => !v)}>
+            <Pencil className="h-3 w-3" />
+          </Button>
+          <Button variant="ghost" size="sm" onClick={remove}>
+            <Trash2 className="h-3 w-3" />
+          </Button>
+        </div>
+      </div>
+      {editing ? (
+        <div className="mt-2 flex flex-wrap items-end gap-2">
+          <label className="text-xs">
+            Status
+            <select value={status} onChange={(e) => setStatus(e.target.value)} className="ml-1 rounded border px-2 py-1 text-xs">
+              {statuses.map((s) => (
+                <option key={s} value={s}>{s}</option>
+              ))}
+            </select>
+          </label>
+          <label className="text-xs">
+            Expires
+            <input type="date" value={expiresDate} onChange={(e) => setExpiresDate(e.target.value)}
+              className="ml-1 rounded border px-2 py-1 text-xs" />
+          </label>
+          <Button variant="primary" size="sm" onClick={save}>Save</Button>
+        </div>
+      ) : null}
+      {error ? <div className="mt-1 text-xs text-rose-700">{error}</div> : null}
+    </div>
+  );
+}
+
+export default function EmployeeCertifications({ employee, onChanged }) {
+  const [options, setOptions] = useState(null);
+  const [records, setRecords] = useState([]);
+  const [form, setForm] = useState(EMPTY_FORM);
+  const [adding, setAdding] = useState(false);
+  const [target, setTarget] = useState(employee.guidewire_certification_expected || "None");
+  const [currentLevel, setCurrentLevel] = useState(employee.guidewire_certification_current || null);
+  const [message, setMessage] = useState("");
+  const [error, setError] = useState("");
+
+  const load = useCallback(async () => {
+    try {
+      const [opts, list] = await Promise.all([getCertificationOptions(), listEmployeeCertificates(employee.id)]);
+      setOptions(opts);
+      setRecords(list.certificates || []);
+      setCurrentLevel(list.guidewire_certification_current || null);
+    } catch (err) {
+      setError(err.message || "Failed to load certificates.");
+    }
+  }, [employee.id]);
+
+  useEffect(() => {
+    load();
+  }, [load]);
+
+  const changed = () => {
+    load();
+    onChanged();
+  };
+
+  const add = async () => {
+    if (!form.certificationId || !form.earnedDate) {
+      setError("Pick a certificate and the date it was earned.");
+      return;
+    }
+    if (form.expiresDate && form.expiresDate < form.earnedDate) {
+      setError("The expiry date must be on or after the earned date.");
+      return;
+    }
+    setError("");
+    try {
+      await addEmployeeCertificate(employee.id, {
+        certification_id: form.certificationId,
+        earned_date: form.earnedDate,
+        expires_date: form.expiresDate || null,
+        issuer: form.issuer || null,
+        cert_number: form.certNumber || null,
+      });
+      setForm(EMPTY_FORM);
+      setAdding(false);
+      changed();
+    } catch (err) {
+      setError(err.message || "Failed to add the certificate.");
+    }
+  };
+
+  const saveTarget = async () => {
+    setError("");
+    setMessage("");
+    try {
+      await updateEmployeeCertifications(employee.id, { guidewire_certification_expected: target });
+      setMessage("Target saved");
+      onChanged();
+    } catch (err) {
+      setError(err.message || "Failed to save the target level.");
+    }
+  };
+
+  return (
+    <div className="border-t pt-4">
+      <h3 className="mb-1 flex items-center gap-1 font-semibold">
+        <Award className="h-4 w-4" /> Certifications
+      </h3>
+      <p className="mb-3 text-xs text-gray-500">
+        Every certificate held, with its expiry. The current Guidewire level comes from these records.
+      </p>
+
+      <div className="mb-3 grid grid-cols-2 gap-4 text-sm">
+        <div>
+          <div className="mb-1 font-semibold text-gray-700">Current Guidewire level</div>
+          <div>{currentLevel || "None held"}</div>
+        </div>
+        <div>
+          <label className="mb-1 block font-semibold text-gray-700">Target level</label>
+          <div className="flex gap-2">
+            <select value={target} onChange={(e) => setTarget(e.target.value)} className="w-full rounded-lg border px-3 py-2 text-sm">
+              {(options?.guidewire_levels || ["None"]).map((level) => (
+                <option key={level} value={level}>{level}</option>
+              ))}
+            </select>
+            <Button variant="secondary" size="sm" onClick={saveTarget}>Save</Button>
+          </div>
+        </div>
+      </div>
+
+      <div className="space-y-2">
+        {records.length === 0 ? <div className="text-sm text-gray-500">No certificates recorded.</div> : null}
+        {records.map((record) => (
+          <CertificateRow key={record.id} record={record} statuses={options?.statuses || []} employeeId={employee.id}
+            onChanged={changed} />
+        ))}
+      </div>
+
+      {adding ? (
+        <div className="mt-3 grid grid-cols-2 gap-2 rounded border p-3 text-sm">
+          <label className="col-span-2">
+            <span className="text-xs font-semibold text-gray-700">Certificate</span>
+            <select value={form.certificationId} onChange={(e) => setForm({ ...form, certificationId: e.target.value })}
+              className="w-full rounded-lg border px-3 py-2 text-sm">
+              <option value="">Select a certificate</option>
+              {(options?.certifications || []).map((c) => (
+                <option key={c.id} value={c.id}>
+                  {c.cert_name}{c.validity_months ? ` (valid ${c.validity_months} months)` : ""}
+                </option>
+              ))}
+            </select>
+          </label>
+          <label>
+            <span className="text-xs font-semibold text-gray-700">Earned</span>
+            <input type="date" value={form.earnedDate} onChange={(e) => setForm({ ...form, earnedDate: e.target.value })}
+              className="w-full rounded-lg border px-3 py-2 text-sm" />
+          </label>
+          <label>
+            <span className="text-xs font-semibold text-gray-700">Expires (blank: catalog validity)</span>
+            <input type="date" value={form.expiresDate} onChange={(e) => setForm({ ...form, expiresDate: e.target.value })}
+              className="w-full rounded-lg border px-3 py-2 text-sm" />
+          </label>
+          <label>
+            <span className="text-xs font-semibold text-gray-700">Issuer</span>
+            <input value={form.issuer} onChange={(e) => setForm({ ...form, issuer: e.target.value })}
+              className="w-full rounded-lg border px-3 py-2 text-sm" />
+          </label>
+          <label>
+            <span className="text-xs font-semibold text-gray-700">Certificate number</span>
+            <input value={form.certNumber} onChange={(e) => setForm({ ...form, certNumber: e.target.value })}
+              className="w-full rounded-lg border px-3 py-2 text-sm" />
+          </label>
+          <div className="col-span-2 flex gap-2">
+            <Button variant="primary" size="sm" onClick={add}>Add certificate</Button>
+            <Button variant="ghost" size="sm" onClick={() => setAdding(false)}>Cancel</Button>
+          </div>
+        </div>
+      ) : (
+        <Button variant="secondary" size="sm" className="mt-3" onClick={() => setAdding(true)}>
+          Add certificate
+        </Button>
+      )}
+      {message ? <div className="mt-2 text-xs text-gray-600">{message}</div> : null}
+      {error ? <div className="mt-2 text-xs text-rose-700">{error}</div> : null}
+    </div>
+  );
+}
