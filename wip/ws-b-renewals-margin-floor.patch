diff --git a/frontend/src/screens/RateCardScreen.js b/frontend/src/screens/RateCardScreen.js
new file mode 100644
index 00000000..d5f7ad8c
--- /dev/null
+++ b/frontend/src/screens/RateCardScreen.js
@@ -0,0 +1,164 @@
+// Rate card (CEO 2026-10-23): the margin floor a placement is checked against, by delivery engine
+// (Staff Aug / Core) and optionally delivery country and role. Below the minimum a BU Head
+// approves the placement; below the hard floor a Partner does. No row = no floor (the placement
+// is allowed and flagged). Finance sets the numbers; nothing is pre-filled.
+import { useCallback, useEffect, useState } from "react";
+import { Percent, RefreshCw } from "lucide-react";
+import { Button, Card, Input, Select } from "../components/ui";
+import { hasPermission } from "../utils/permissionsRoleTemplate";
+import { confirmDialog } from "../utils/dialogs";
+import {
+  createMarginPolicy, deleteMarginPolicy, getMarginPolicies, updateMarginPolicy,
+} from "../services/api/marginPolicies";
+
+const EMPTY = { delivery_engine: "", country: "", role: "", min_margin_pct: "", hard_floor_pct: "", active: true };
+
+export default function RateCardScreen() {
+  const [data, setData] = useState(null);
+  const [form, setForm] = useState(EMPTY);
+  const [editingId, setEditingId] = useState(null);
+  const [error, setError] = useState("");
+  const [saving, setSaving] = useState(false);
+  const canCreate = hasPermission("finance-operations", "create");
+  const canEdit = hasPermission("finance-operations", "edit");
+  const canDelete = hasPermission("finance-operations", "delete");
+
+  const load = useCallback(async () => {
+    setError("");
+    try {
+      setData(await getMarginPolicies());
+    } catch (err) {
+      setError(err.message || "Failed to load the rate card.");
+    }
+  }, []);
+
+  useEffect(() => {
+    load();
+  }, [load]);
+
+  const set = (key) => (value) => setForm((f) => ({ ...f, [key]: value }));
+  const engines = data?.engines || [];
+  const countries = data?.countries || [];
+  const engineName = (code) => engines.find((e) => e.code === code)?.name || code;
+  const countryName = (code) => (code ? countries.find((c) => c.code === code)?.name || code : "Any country");
+
+  const save = async () => {
+    if (!form.delivery_engine || form.min_margin_pct === "" || form.hard_floor_pct === "") {
+      setError("Pick the delivery engine and set both percentages.");
+      return;
+    }
+    setSaving(true);
+    setError("");
+    try {
+      if (editingId) await updateMarginPolicy(editingId, form);
+      else await createMarginPolicy(form);
+      setForm(EMPTY);
+      setEditingId(null);
+      await load();
+    } catch (err) {
+      setError(err.message || "Could not save the row.");
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  const edit = (row) => {
+    setEditingId(row.id);
+    setForm({ ...row, country: row.country || "", role: row.role || "",
+      min_margin_pct: String(row.min_margin_pct), hard_floor_pct: String(row.hard_floor_pct) });
+  };
+
+  const remove = async (row) => {
+    if (!(await confirmDialog("Remove this margin floor?", { danger: true }))) return;
+    try {
+      await deleteMarginPolicy(row.id);
+      await load();
+    } catch (err) {
+      setError(err.message || "Could not remove the row.");
+    }
+  };
+
+  const toggle = async (row) => {
+    try {
+      await updateMarginPolicy(row.id, { ...row, active: !row.active });
+      await load();
+    } catch (err) {
+      setError(err.message || "Could not change the row.");
+    }
+  };
+
+  return (
+    <Card
+      title="Rate Card"
+      subtitle="Margin floor per placement: margin % = (bill rate - loaded hourly cost) / bill rate. Below the minimum a BU Head approves; below the hard floor a Partner approves. No matching row = no floor (allowed, flagged)."
+      icon={<Percent className="h-4 w-4" />}
+      right={<Button variant="ghost" onClick={load}><RefreshCw className="h-4 w-4" /></Button>}
+    >
+      {error && <div className="mb-3 rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700">{error}</div>}
+      {data && data.policies.length === 0 && (
+        <div className="mb-3 rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800">
+          No margin floor is configured: every placement is accepted at any bill rate and flagged.
+        </div>
+      )}
+      {data && data.policies.length > 0 && (
+        <div className="mb-4 overflow-x-auto rounded-lg border">
+          <table className="w-full text-sm">
+            <thead className="border-b bg-gray-50 text-left">
+              <tr>
+                <th className="px-3 py-2 font-semibold">Delivery engine</th>
+                <th className="px-3 py-2 font-semibold">Country</th>
+                <th className="px-3 py-2 font-semibold">Role</th>
+                <th className="px-3 py-2 font-semibold">Minimum margin</th>
+                <th className="px-3 py-2 font-semibold">Hard floor</th>
+                <th className="px-3 py-2 font-semibold">Active</th>
+                <th className="px-3 py-2 font-semibold" />
+              </tr>
+            </thead>
+            <tbody>
+              {data.policies.map((row) => (
+                <tr key={row.id} className="border-b">
+                  <td className="px-3 py-2">{engineName(row.delivery_engine)}</td>
+                  <td className="px-3 py-2">{countryName(row.country)}</td>
+                  <td className="px-3 py-2">{row.role || "Any role"}</td>
+                  <td className="px-3 py-2">{row.min_margin_pct}%</td>
+                  <td className="px-3 py-2">{row.hard_floor_pct}%</td>
+                  <td className="px-3 py-2">
+                    {canEdit ? (
+                      <input type="checkbox" checked={row.active} onChange={() => toggle(row)} />
+                    ) : (row.active ? "yes" : "no")}
+                  </td>
+                  <td className="space-x-1 px-3 py-2">
+                    {canEdit && <Button variant="ghost" size="sm" onClick={() => edit(row)}>Edit</Button>}
+                    {canDelete && <Button variant="ghost" size="sm" onClick={() => remove(row)}>Remove</Button>}
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      )}
+      {(editingId ? canEdit : canCreate) && data && (
+        <div className="rounded-2xl border bg-gray-50 p-4">
+          <div className="mb-3 text-sm font-semibold text-gray-900">{editingId ? "Edit floor" : "Add a floor"}</div>
+          <div className="grid gap-3 sm:grid-cols-3">
+            <Select label="Delivery engine" value={form.delivery_engine} onChange={set("delivery_engine")}
+              options={[{ value: "", label: "Select" }, ...engines.map((e) => ({ value: e.code, label: e.name }))]} />
+            <Select label="Country (where the consultant delivers from)" value={form.country} onChange={set("country")}
+              options={[{ value: "", label: "Any country" }, ...countries.map((c) => ({ value: c.code, label: c.name }))]} />
+            <Input label="Role (optional, matches the allocation's role)" value={form.role} onChange={set("role")} />
+            <Input label="Minimum margin % (below: BU Head approves)" type="number" value={form.min_margin_pct}
+              onChange={set("min_margin_pct")} />
+            <Input label="Hard floor % (below: Partner approves)" type="number" value={form.hard_floor_pct}
+              onChange={set("hard_floor_pct")} />
+          </div>
+          <div className="mt-3 flex gap-2">
+            <Button variant="primary" onClick={save} disabled={saving}>{saving ? "Saving…" : "Save"}</Button>
+            {editingId && (
+              <Button variant="ghost" onClick={() => { setEditingId(null); setForm(EMPTY); }}>Cancel</Button>
+            )}
+          </div>
+        </div>
+      )}
+    </Card>
+  );
+}
diff --git a/frontend/src/screens/RenewalsScreen.js b/frontend/src/screens/RenewalsScreen.js
new file mode 100644
index 00000000..c9bc0caa
--- /dev/null
+++ b/frontend/src/screens/RenewalsScreen.js
@@ -0,0 +1,215 @@
+// Renewals (CEO 2026-10-23): the extension pipeline for placements ending soon -- days left, bill
+// rate, renewal status and owner (the client's account manager, else the BU Head, unless someone
+// is set), with Extend (new date + rate + reason), Mark rolling off and Set owner / status. The
+// renewal owner gets a task at the configured days before the end (60/30/15); the task opens
+// this tab with ?allocation=<id>, which highlights that row.
+import { useCallback, useEffect, useMemo, useState } from "react";
+import { useSearchParams } from "react-router-dom";
+import { CalendarClock, RefreshCw } from "lucide-react";
+import { Button, Card, Select } from "../components/ui";
+import cx from "../utils/cx";
+import { hasPermission } from "../utils/permissionsRoleTemplate";
+import AllocationEditModal from "../components/AllocationEditModal";
+import { marginLabel } from "../components/AllocationMargin";
+import { getAllocations, getRenewals, updateRenewal } from "../services/api/allocations";
+import { searchUsers } from "../services/api/users";
+
+const STATUS_OPTIONS = [
+  { value: "NOT_STARTED", label: "Not started" },
+  { value: "IN_DISCUSSION", label: "In discussion" },
+  { value: "EXTENDED", label: "Extended (agreed)" },
+  { value: "ROLLING_OFF", label: "Rolling off" },
+];
+const STATUS_TONE = {
+  NOT_STARTED: "bg-gray-100 text-gray-700",
+  IN_DISCUSSION: "bg-sky-100 text-sky-800",
+  EXTENDED: "bg-emerald-100 text-emerald-800",
+  ROLLING_OFF: "bg-amber-100 text-amber-800",
+};
+const OWNER_SOURCE = { SET: "set", ACCOUNT_MANAGER: "account manager", BU_HEAD: "BU Head" };
+const HORIZONS = [
+  { value: "30", label: "Next 30 days" },
+  { value: "60", label: "Next 60 days" },
+  { value: "90", label: "Next 90 days" },
+  { value: "180", label: "Next 180 days" },
+];
+
+const daysTone = (days, alertDays) => {
+  if (days == null) return "text-gray-500";
+  if (days < 0 || days <= Math.min(...alertDays)) return "font-semibold text-rose-700";
+  if (days <= Math.max(...alertDays)) return "text-amber-700";
+  return "text-gray-700";
+};
+
+function OwnerPicker({ row, users, onSave }) {
+  const options = useMemo(() => [
+    { value: "", label: `Default (${row.renewal_owner_source && row.renewal_owner_source !== "SET"
+      ? OWNER_SOURCE[row.renewal_owner_source] : "account manager / BU Head"})` },
+    ...users.map((u) => ({ value: u.UserID, label: u.UserName })),
+  ], [users, row.renewal_owner_source]);
+  const current = row.renewal_owner_source === "SET" ? row.renewal_owner_user_id : "";
+  return <Select value={current} onChange={(value) => onSave({ ownerUserId: value })} options={options} />;
+}
+
+export default function RenewalsScreen() {
+  const [searchParams] = useSearchParams();
+  const focusId = searchParams.get("allocation");
+  const [days, setDays] = useState("90");
+  const [data, setData] = useState(null);
+  const [users, setUsers] = useState([]);
+  const [error, setError] = useState("");
+  const [loading, setLoading] = useState(true);
+  const [editing, setEditing] = useState(null);
+  const canEdit = hasPermission("allocations", "edit");
+
+  const load = useCallback(async () => {
+    setLoading(true);
+    setError("");
+    try {
+      setData(await getRenewals(days));
+    } catch (err) {
+      setError(err.message || "Failed to load renewals.");
+    } finally {
+      setLoading(false);
+    }
+  }, [days]);
+
+  useEffect(() => {
+    load();
+  }, [load]);
+
+  useEffect(() => {
+    if (!canEdit) return;
+    searchUsers({ limit: 200 })
+      .then((res) => setUsers(res?.users || []))
+      .catch((err) => setError(`Could not load people for the owner list: ${err.message}`));
+  }, [canEdit]);
+
+  useEffect(() => {
+    if (!focusId || !data) return;
+    const el = document.getElementById(`renewal-${focusId}`);
+    if (el) el.scrollIntoView({ block: "center" });
+  }, [focusId, data]);
+
+  const save = async (row, change) => {
+    setError("");
+    try {
+      await updateRenewal(row.allocation_id, change);
+      await load();
+    } catch (err) {
+      setError(err.message || "Could not update the renewal.");
+    }
+  };
+
+  const openExtend = async (row) => {
+    setError("");
+    try {
+      const list = await getAllocations({ employeeId: row.employee_id });
+      const allocation = list.find((a) => a.id === row.allocation_id);
+      if (!allocation) throw new Error("The allocation is no longer visible.");
+      setEditing(allocation);
+    } catch (err) {
+      setError(err.message || "Could not open the allocation.");
+    }
+  };
+
+  const rows = data?.renewals || [];
+  const alertDays = data?.alert_days?.length ? data.alert_days : [15];
+
+  return (
+    <Card
+      title="Renewals"
+      subtitle={`Placements ending soon and where each extension stands. Owners get a task ${alertDays.join(" / ")} days before the end.`}
+      icon={<CalendarClock className="h-4 w-4" />}
+      right={(
+        <div className="flex items-center gap-2">
+          <Select value={days} onChange={setDays} options={HORIZONS} />
+          <Button variant="ghost" onClick={load}><RefreshCw className="h-4 w-4" /></Button>
+        </div>
+      )}
+    >
+      {error && <div className="mb-3 rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700">{error}</div>}
+      {loading ? (
+        <div className="py-6 text-center text-sm text-gray-500">Loading renewals…</div>
+      ) : rows.length === 0 ? (
+        <div className="py-6 text-center text-sm text-gray-500">No placement ends in the next {days} days.</div>
+      ) : (
+        <div className="overflow-x-auto rounded-lg border">
+          <table className="w-full text-sm">
+            <thead className="border-b bg-gray-50 text-left">
+              <tr>
+                <th className="px-3 py-2 font-semibold">Consultant</th>
+                <th className="px-3 py-2 font-semibold">Client · role</th>
+                <th className="px-3 py-2 font-semibold">Ends</th>
+                <th className="px-3 py-2 font-semibold">Days left</th>
+                <th className="px-3 py-2 font-semibold">Bill rate</th>
+                <th className="px-3 py-2 font-semibold">Margin</th>
+                <th className="px-3 py-2 font-semibold">Status</th>
+                <th className="px-3 py-2 font-semibold">Owner</th>
+                <th className="px-3 py-2 font-semibold">Actions</th>
+              </tr>
+            </thead>
+            <tbody>
+              {rows.map((row) => (
+                <tr key={row.allocation_id} id={`renewal-${row.allocation_id}`}
+                  className={cx("border-b align-top", row.allocation_id === focusId && "bg-amber-50")}>
+                  <td className="px-3 py-2 font-medium text-gray-900">{row.employee_name || "—"}</td>
+                  <td className="px-3 py-2 text-gray-700">
+                    {row.client_name || "—"}
+                    <div className="text-xs text-gray-500">{row.role || row.job_title || ""}</div>
+                  </td>
+                  <td className="px-3 py-2 text-gray-700">{row.end_date}</td>
+                  <td className={cx("px-3 py-2", daysTone(row.days_left, alertDays))}>
+                    {row.days_left < 0 ? `${-row.days_left} overdue` : row.days_left}
+                  </td>
+                  <td className="px-3 py-2 text-gray-700">
+                    {row.billing_rate_usd_cents ? `$${(row.billing_rate_usd_cents / 100).toFixed(2)}/h` : "—"}
+                  </td>
+                  <td className="px-3 py-2 text-gray-700">{marginLabel(row.margin_pct)}</td>
+                  <td className="px-3 py-2">
+                    {canEdit ? (
+                      <Select value={row.renewal_status} options={STATUS_OPTIONS}
+                        onChange={(value) => save(row, { renewalStatus: value })} />
+                    ) : (
+                      <span className={cx("rounded-full px-2 py-0.5 text-xs font-semibold", STATUS_TONE[row.renewal_status])}>
+                        {STATUS_OPTIONS.find((o) => o.value === row.renewal_status)?.label}
+                      </span>
+                    )}
+                    {row.renewal_note && <div className="mt-1 text-xs text-gray-500">{row.renewal_note}</div>}
+                    {row.change_pending_approval && (
+                      <div className="mt-1 text-xs font-semibold text-amber-700">Change awaiting margin approval</div>
+                    )}
+                  </td>
+                  <td className="px-3 py-2 text-gray-700">
+                    {canEdit ? <OwnerPicker row={row} users={users} onSave={(c) => save(row, c)} /> : (
+                      row.renewal_owner_name || "No owner"
+                    )}
+                    <div className="text-xs text-gray-500">
+                      {row.renewal_owner_name || "nobody resolved"}
+                      {row.renewal_owner_source ? ` (${OWNER_SOURCE[row.renewal_owner_source]})` : ""}
+                    </div>
+                  </td>
+                  <td className="space-y-1 px-3 py-2">
+                    {canEdit && (
+                      <>
+                        <Button variant="primary" size="sm" onClick={() => openExtend(row)}>Extend</Button>
+                        {row.renewal_status !== "ROLLING_OFF" && (
+                          <Button variant="ghost" size="sm" onClick={() => save(row, { renewalStatus: "ROLLING_OFF" })}>
+                            Mark rolling off
+                          </Button>
+                        )}
+                      </>
+                    )}
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      )}
+      {editing && (
+        <AllocationEditModal allocation={editing} mode="extend" onClose={() => setEditing(null)} onSaved={load} />
+      )}
+    </Card>
+  );
+}
diff --git a/frontend/src/services/api/allocations.js b/frontend/src/services/api/allocations.js
index 798dc954..970b42d2 100644
--- a/frontend/src/services/api/allocations.js
+++ b/frontend/src/services/api/allocations.js
@@ -57,3 +57,71 @@ export const getAllocationDropdowns = async () => {
   const { data } = await apiRequest(`/allocations/dropdowns/for-create`, { method: "GET" });
   return data;
 };
+
+// Edit / extend (CEO 2026-10-23): only the fields given change; a reason is required and kept in
+// the history. Below the margin floor the change waits for approval (change.status PENDING_APPROVAL).
+export const updateAllocation = async (allocationId, { reason, effectiveFrom, ...fields }) => {
+  const body = { reason };
+  ["end_date", "billing_rate_usd_cents", "utilization_pct", "billable"].forEach((key) => {
+    if (Object.prototype.hasOwnProperty.call(fields, key)) body[key] = fields[key];
+  });
+  if (effectiveFrom) body.effective_from = effectiveFrom;
+  const { data } = await apiRequest(`/allocations/${allocationId}`, { method: "PATCH", body: JSON.stringify(body) });
+  return data;
+};
+
+export const getAllocationHistory = async (allocationId) => {
+  const { data } = await apiRequest(`/allocations/${allocationId}/history`, { method: "GET" });
+  if (!data || !Array.isArray(data.changes)) throw new Error("Unexpected response: no history.");
+  return data.changes;
+};
+
+// The margin guard's verdict on the terms in a form: a new placement (employeeId + demandId) or
+// an existing allocation's proposed terms (allocationId).
+export const previewMargin = async ({ employeeId, demandId, projectId, allocationId, billingRateUsdCents,
+  billable, startDate, role }) => {
+  const { data } = await apiRequest("/allocations/margin-preview", {
+    method: "POST",
+    body: JSON.stringify({
+      employee_id: employeeId || undefined,
+      demand_id: demandId || undefined,
+      project_id: projectId || undefined,
+      allocation_id: allocationId || undefined,
+      billing_rate_usd_cents: billingRateUsdCents || undefined,
+      billable: typeof billable === "boolean" ? billable : undefined,
+      start_date: startDate || undefined,
+      role: role || undefined,
+    }),
+  });
+  return data;
+};
+
+export const listMarginApprovals = async () => {
+  const { data } = await apiRequest("/allocations/margin-approvals", { method: "GET" });
+  if (!data || !Array.isArray(data.approvals)) throw new Error("Unexpected response: no approvals list.");
+  return data.approvals;
+};
+
+export const decideMarginChange = async (changeId, approve, reason) => {
+  const { data } = await apiRequest(`/allocations/changes/${changeId}/${approve ? "approve" : "reject"}`, {
+    method: "POST",
+    body: JSON.stringify({ reason }),
+  });
+  return data;
+};
+
+// Renewal pipeline (Demand vs Bench > Renewals)
+export const getRenewals = async (days) => {
+  const { data } = await apiRequest(`/allocations/renewals${days ? `?days=${days}` : ""}`, { method: "GET" });
+  if (!data || !Array.isArray(data.renewals)) throw new Error("Unexpected response: no renewals list.");
+  return data;
+};
+
+// ownerUserId "" puts the owner back to the default (account manager, else BU Head)
+export const updateRenewal = async (allocationId, { renewalStatus, ownerUserId, note, reason }) => {
+  const { data } = await apiRequest(`/allocations/${allocationId}/renewal`, {
+    method: "PUT",
+    body: JSON.stringify({ renewal_status: renewalStatus, owner_user_id: ownerUserId, note, reason }),
+  });
+  return data;
+};
diff --git a/frontend/src/services/api/marginPolicies.js b/frontend/src/services/api/marginPolicies.js
new file mode 100644
index 00000000..cfc84141
--- /dev/null
+++ b/frontend/src/services/api/marginPolicies.js
@@ -0,0 +1,32 @@
+// Rate card / margin floors by delivery engine, country and role (P&L > Rate Card).
+import { apiRequest } from "./client";
+
+export const getMarginPolicies = async () => {
+  const { data } = await apiRequest("/margin-policies", { method: "GET" });
+  if (!data || !Array.isArray(data.policies)) throw new Error("Unexpected response: no rate card.");
+  return data;
+};
+
+const toBody = (row) => JSON.stringify({
+  delivery_engine: row.delivery_engine,
+  country: row.country || null,
+  role: row.role || null,
+  min_margin_pct: Number(row.min_margin_pct),
+  hard_floor_pct: Number(row.hard_floor_pct),
+  active: row.active !== false,
+});
+
+export const createMarginPolicy = async (row) => {
+  const { data } = await apiRequest("/margin-policies", { method: "POST", body: toBody(row) });
+  return data;
+};
+
+export const updateMarginPolicy = async (id, row) => {
+  const { data } = await apiRequest(`/margin-policies/${id}`, { method: "PUT", body: toBody(row) });
+  return data;
+};
+
+export const deleteMarginPolicy = async (id) => {
+  const { data } = await apiRequest(`/margin-policies/${id}`, { method: "DELETE" });
+  return data;
+};
