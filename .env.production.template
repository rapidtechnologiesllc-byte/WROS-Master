# PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env.production and fill in actual values

# ════════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION (SQL Server Production)
# ════════════════════════════════════════════════════════════════════

# SQL Server Connection String (Windows Authentication)
# DATABASE_URL=mssql+pyodbc://server_hostname/database_name?driver=ODBC+Driver+17+for+SQL+Server&Trusted_Connection=yes

# SQL Server Connection String (SQL Authentication)
# DATABASE_URL=mssql+pyodbc://username:password@server_hostname/database_name?driver=ODBC+Driver+17+for+SQL+Server

# PostgreSQL Connection String
# DATABASE_URL=postgresql://username:password@host:5432/database_name

# Example SQL Server (replace with actual values):
# DATABASE_URL=mssql+pyodbc://sa:YourPassword123!@prod-sqlserver.blitzenx.com/BlitzenX_WROS?driver=ODBC+Driver+17+for+SQL+Server

# ════════════════════════════════════════════════════════════════════
# MICROSOFT AUTHENTICATION
# ════════════════════════════════════════════════════════════════════
TENANT_ID=your_azure_tenant_id
CLIENT_ID=your_azure_client_id
CLIENT_SECRET=your_azure_client_secret
REDIRECT_URI=https://hrms-backend.blitzenx.com/msgraph/auth/callback
AUTHORITY=https://login.microsoftonline.com/{TENANT_ID}
SCOPES=https://graph.microsoft.com/.default

# ════════════════════════════════════════════════════════════════════
# AZURE STORAGE (Document Upload)
# ════════════════════════════════════════════════════════════════════
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
SHAREPOINT_SITE_ID=your_sharepoint_site_id
SHAREPOINT_DRIVE_ID=your_sharepoint_drive_id
SHAREPOINT_BASE_FOLDER=candidates/2026
SHAREPOINT_TEMPLATE_PATH=templates/Internship Offer letter.docx
SHAREPOINT_FULLTIME_TEMPLATE_PATH=templates/Full Time Offer letter.docx
SHAREPOINT_GENERATED_FOLDER=generated-offers

# ════════════════════════════════════════════════════════════════════
# JWT KEYS (Production - Use real keys from Key Vault)
# ════════════════════════════════════════════════════════════════════
JWT_PRIVATE_KEY=your_production_private_key_from_key_vault
JWT_PUBLIC_KEY=your_production_public_key_from_key_vault

# ════════════════════════════════════════════════════════════════════
# GEMINI/AI
# ════════════════════════════════════════════════════════════════════
GEMINI_API_KEY=your_gemini_api_key

# ════════════════════════════════════════════════════════════════════
# COMMUNICATION
# ════════════════════════════════════════════════════════════════════
THUNDER_WHATSAPP_NUMBER=+your_real_whatsapp_number

# ════════════════════════════════════════════════════════════════════
# PRODUCTION URLS
# ════════════════════════════════════════════════════════════════════
PRODUCTION_BACKEND_URL=https://hrms-backend.blitzenx.com/
PRODUCTION_FRONTEND_URL=https://hrms.blitzenx.com/
REDIRECT_RESPONSE=https://hrms.blitzenx.com/

# ════════════════════════════════════════════════════════════════════
# LOGGING & MONITORING (Optional)
# ════════════════════════════════════════════════════════════════════
LOG_LEVEL=INFO
ENABLE_SENTRY=true
SENTRY_DSN=your_sentry_dsn_if_using_sentry

# ════════════════════════════════════════════════════════════════════
# SECURITY
# ════════════════════════════════════════════════════════════════════
# Set to true in production to enforce HTTPS
FORCE_HTTPS=true
# Secret key for session management
SECRET_KEY=your_random_secret_key_min_32_chars
