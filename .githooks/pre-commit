#!/bin/bash
# MANDATORY REGRESSION SUITE PRE-COMMIT HOOK
# This runs EVERY commit to ensure code quality
# Set up with: git config core.hooksPath .githooks

set -e

echo "================================================"
echo "MANDATORY REGRESSION TEST SUITE"
echo "================================================"
echo ""

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only)

# Check if any Python files are being committed
if echo "$STAGED_FILES" | grep -E '\.py$' > /dev/null; then
    echo "Python files detected in commit."
    echo "Running regression suite (this is MANDATORY)..."
    echo ""

    # Run the comprehensive regression suite
    if python -m pytest tests/regression_suite.py -v --tb=short; then
        echo ""
        echo "✓ All regression tests PASSED"
        echo "✓ Proceeding with commit"
        exit 0
    else
        echo ""
        echo "✗ REGRESSION TESTS FAILED"
        echo "✗ Commit BLOCKED until tests pass"
        echo ""
        echo "To fix:"
        echo "  1. Run: pytest tests/regression_suite.py -v"
        echo "  2. Fix failing tests"
        echo "  3. Stage changes: git add ."
        echo "  4. Try commit again"
        exit 1
    fi
else
    echo "No Python files in this commit - skipping regression suite"
    exit 0
fi
