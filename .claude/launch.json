{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8081"],
      "port": 8081,
      "cwd": "backend",
      "note": "FIXED: Port hardcoded to 8081 (autoPort removed). Kill any process on 8081 if startup fails."
    },
    {
      "name": "Frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 3000,
      "url": "http://localhost:3000",
      "cwd": "frontend"
    },
    {
      "name": "Career Site",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3001,
      "autoPort": false,
      "cwd": "career-site"
    }
  ]
}
