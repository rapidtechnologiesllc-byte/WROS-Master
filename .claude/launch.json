{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8080"],
      "port": 8080,
      "cwd": "backend",
      "note": "Port hardcoded to 8080 (matches setupProxy.js and the documented backend port). Kill any process on 8080 if startup fails."
    },
    {
      "name": "Frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 3000,
      "autoPort": true,
      "cwd": "frontend"
    },
    {
      "name": "Career Site",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3001,
      "autoPort": false,
      "cwd": "career-site"
    }
  ]
}
