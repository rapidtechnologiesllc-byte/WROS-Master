{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8081"],
      "port": 8081,
      "autoPort": true,
      "cwd": "backend",
      "note": "Uses autoPort to find available port if 8081 is in use. Frontend configured to use REACT_APP_API_URL from .env"
    },
    {
      "name": "Frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 3000,
      "autoPort": true,
      "url": "http://localhost:3000",
      "cwd": "frontend"
    },
    {
      "name": "Career Site",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3001,
      "autoPort": false,
      "cwd": "career-site"
    }
  ]
}
