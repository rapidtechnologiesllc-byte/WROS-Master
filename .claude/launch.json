{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Backend",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8081"
      ],
      "port": 8081,
      "autoPort": false,
      "cwd": "backend",
      "note": "8081 is where the frontend calls the API (frontend/.env REACT_APP_API_URL, src/setupProxy.js)"
    },
    {
      "name": "Frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "port": 3000,
      "autoPort": true,
      "cwd": "frontend"
    },
    {
      "name": "Career Site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3001,
      "autoPort": false,
      "cwd": "career"
    }
  ]
}
