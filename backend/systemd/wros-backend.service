[Unit]
Description=WROS Backend (Uvicorn + FastAPI)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=notify
User=hrms
Group=hrms
WorkingDirectory=/home/HRMS/WROS-Master/backend

# Environment variables
Environment="PYTHONUNBUFFERED=1"
Environment="ENVIRONMENT=production"
Environment="PORT=8080"

# Load .env file if it exists (secrets should be in /etc/wros/backend.env)
EnvironmentFile=-/etc/wros/backend.env
EnvironmentFile=-/home/HRMS/WROS-Master/backend/.env.production

# Start command - uses absolute path to venv Python
ExecStart=/home/HRMS/WROS-Master/venv/bin/python -m uvicorn app.main:app \
  --host 0.0.0.0 \
  --port 8080 \
  --workers 4 \
  --loop uvloop \
  --http httptools

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=600
StartLimitBurst=5

# Resource limits
MemoryLimit=2G
CPUQuota=80%

# Logging
StandardOutput=append:/var/log/wros/backend.log
StandardError=append:/var/log/wros/backend-error.log

# Permissions
PrivateTmp=true

[Install]
WantedBy=multi-user.target
