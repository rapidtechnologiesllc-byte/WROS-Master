# ⚠️ PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT THIS FILE TO GIT
# This is a TEMPLATE showing how to configure production.
# In production: set values as GitHub Secrets, NOT in files.

# Production Database Connection
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://prod_user:SUPER_SECRET_PASSWORD@prod-db.example.com:5432/onboarding_prod

# Environment indicator - set to "production" in CI/CD only
ENVIRONMENT=production

# ====================================================
# SETUP INSTRUCTIONS
# ====================================================
#
# 1. GitHub Secrets Setup:
#    - Go to Settings → Secrets and variables → Actions
#    - Add: PROD_DATABASE_URL = postgresql://...@prod.host/onboarding_prod
#    - Add: PROD_ENVIRONMENT = production
#
# 2. CI/CD Workflow (.github/workflows/deploy.yml):
#    env:
#      ENVIRONMENT: ${{ secrets.PROD_ENVIRONMENT }}
#      DATABASE_URL: ${{ secrets.PROD_DATABASE_URL }}
#
# 3. Production Server:
#    - Use env vars or secrets manager (AWS Secrets Manager, etc.)
#    - NEVER hardcode credentials
#
# ====================================================
# SAFETY GUARANTEE
# ====================================================
#
# If you see: "🚨 PRODUCTION DATABASE DETECTED..."
# It means you accidentally set prod URL in .env WITHOUT ENVIRONMENT=production
#
# FIX:
# 1. Delete any production URLs from backend/.env
# 2. Ensure backend/.env only has: DATABASE_URL=postgresql://app_user:...@localhost:5432/wros_dev
# 3. Production credentials ONLY in GitHub Secrets or CI/CD environment
#
