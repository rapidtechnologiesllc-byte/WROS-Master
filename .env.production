# ════════════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT CONFIGURATION
# ════════════════════════════════════════════════════════════════════
# PostgreSQL ONLY - No SQLite, No SQL Server
# ════════════════════════════════════════════════════════════════════

# ════════════════════════════════════════════════════════════════════
# CRITICAL: DATABASE CONFIGURATION - PostgreSQL REQUIRED
# ════════════════════════════════════════════════════════════════════
# Format: postgresql://username:password@host:port/database_name
#
# IMPORTANT: Replace these values with your actual PostgreSQL credentials
# The installation script requires this to proceed
#
# For CloudMinister hosting:
#   - Username: typically provided by CloudMinister
#   - Password: strong password (min 16 chars)
#   - Host: your database server hostname (e.g., db.yourserver.com OR localhost if on same server)
#   - Port: 5432 (default PostgreSQL port)
#   - Database: wros_prod (or whatever name you choose)
#
# Example: postgresql://postgres:YourSecurePassword123!@db.cloudminister.com:5432/wros_prod
#
# SECURITY CHECKLIST:
# ✅ Use strong password (uppercase, lowercase, numbers, symbols)
# ✅ Use managed PostgreSQL if available
# ✅ Enable SSL for connections
# ✅ Use VPC/private network (never expose to internet)
#
# IMPORTANT: This matches what setup-postgres-vps.sh creates automatically:
#   - Database: onboarding_prod
#   - User: app_user
#   - Password: Generate your own strong password below
#
# Generate a strong password: openssl rand -base64 20
# Example: postgresql://app_user:Kx9mP2jL4wQ8vN5rT6sH@localhost:5432/onboarding_prod
#
DATABASE_URL=postgresql://app_user:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/onboarding_prod

# ════════════════════════════════════════════════════════════════════
# ENVIRONMENT & APPLICATION
# ════════════════════════════════════════════════════════════════════
ENVIRONMENT=production
APP_NAME=WROS
APP_VERSION=1.0.0
DEBUG=False

# ════════════════════════════════════════════════════════════════════
# SECURITY
# ════════════════════════════════════════════════════════════════════
# Generate a new secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY_32_CHARS_MINIMUM

# Force HTTPS in production
FORCE_HTTPS=true

# Allowed hosts (comma-separated) - Update with your actual domain
ALLOWED_HOSTS=hrms.blitzenx.com,hrms-backend.blitzenx.com,localhost

# ════════════════════════════════════════════════════════════════════
# JWT AUTHENTICATION KEYS
# ════════════════════════════════════════════════════════════════════
# IMPORTANT: Generate new keys for production (don't use dev keys)
# Keys are in .env.local for development - generate NEW ones for production
#
# To generate new keys:
# python -c "from cryptography.hazmat.primitives.asymmetric import rsa; from cryptography.hazmat.primitives import serialization; from cryptography.hazmat.backends import default_backend; private_key = rsa.generate_private_key(public_exponent=65537, key_size=2048, backend=default_backend()); private_pem = private_key.private_bytes(encoding=serialization.Encoding.PEM, format=serialization.PrivateFormat.PKCS8, encryption_algorithm=serialization.NoEncryption()); public_key = private_key.public_key(); public_pem = public_key.public_bytes(encoding=serialization.Encoding.PEM, format=serialization.PublicFormat.SubjectPublicKeyInfo); print('PRIVATE:'); print(private_pem.decode()); print('PUBLIC:'); print(public_pem.decode())"
#
JWT_PRIVATE_KEY=REPLACE_WITH_YOUR_PRODUCTION_PRIVATE_KEY
JWT_PUBLIC_KEY=REPLACE_WITH_YOUR_PRODUCTION_PUBLIC_KEY

# ════════════════════════════════════════════════════════════════════
# MICROSOFT GRAPH / OFFICE 365 INTEGRATION
# ════════════════════════════════════════════════════════════════════
# Get these from Azure Portal > App Registrations
TENANT_ID=your_azure_tenant_id_here
CLIENT_ID=your_azure_client_id_here
CLIENT_SECRET=your_azure_client_secret_here
REDIRECT_URI=https://hrms-backend.blitzenx.com/msgraph/auth/callback
AUTHORITY=https://login.microsoftonline.com/{TENANT_ID}
SCOPES=https://graph.microsoft.com/.default

# ════════════════════════════════════════════════════════════════════
# AZURE STORAGE (Document Upload)
# ════════════════════════════════════════════════════════════════════
# Optional: Only needed if using SharePoint for offer letters
AZURE_TENANT_ID=your_azure_tenant_id_here
AZURE_CLIENT_ID=your_azure_client_id_here
AZURE_CLIENT_SECRET=your_azure_client_secret_here
SHAREPOINT_SITE_ID=your_sharepoint_site_id_here
SHAREPOINT_DRIVE_ID=your_sharepoint_drive_id_here
SHAREPOINT_BASE_FOLDER=candidates/2026
SHAREPOINT_TEMPLATE_PATH=templates/Internship Offer letter.docx
SHAREPOINT_FULLTIME_TEMPLATE_PATH=templates/Full Time Offer letter.docx
SHAREPOINT_GENERATED_FOLDER=generated-offers

# ════════════════════════════════════════════════════════════════════
# AI / LLM
# ════════════════════════════════════════════════════════════════════
# Get API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ════════════════════════════════════════════════════════════════════
# COMMUNICATION
# ════════════════════════════════════════════════════════════════════
# Optional: WhatsApp integration for Thunder autonomous system
THUNDER_WHATSAPP_NUMBER=+your_real_whatsapp_number

# ════════════════════════════════════════════════════════════════════
# EMAIL CONFIGURATION
# ════════════════════════════════════════════════════════════════════
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@blitzenx.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_EMAIL=noreply@blitzenx.com

# ════════════════════════════════════════════════════════════════════
# PRODUCTION URLs
# ════════════════════════════════════════════════════════════════════
PRODUCTION_BACKEND_URL=https://hrms-backend.blitzenx.com/
PRODUCTION_FRONTEND_URL=https://hrms.blitzenx.com/
REDIRECT_RESPONSE=https://hrms.blitzenx.com/

# ════════════════════════════════════════════════════════════════════
# LOGGING & MONITORING
# ════════════════════════════════════════════════════════════════════
LOG_LEVEL=INFO
LOG_FORMAT=json

# Optional: Sentry error tracking
ENABLE_SENTRY=false
SENTRY_DSN=your_sentry_dsn_if_using_sentry

# ════════════════════════════════════════════════════════════════════
# FEATURE FLAGS
# ════════════════════════════════════════════════════════════════════
ENABLE_REFERRAL_PROGRAM=True
ENABLE_BULK_IMPORT=True
ENABLE_AI_RECRUITER=True
ENABLE_EMPLOYEE_KPI=True
ENABLE_CERTIFICATIONS=True
