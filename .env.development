# Loaded automatically by `npm start` (CRA sets NODE_ENV=development).
# Ensures local dev NEVER silently talks to the real production backend --
# see client.js's now-safe fallback for why this file exists.
# 2026-08-06: moved to 8081 -- a stale process from before today's
# local-DB fix is stuck holding 8080 and can't be killed from this
# session (process-visibility boundary, see CLAUDE.md). The real local
# backend (SQLite, .env.local) runs on 8081 now. Move back to 8080 once
# that stale process is manually closed, if you want the old port back.
REACT_APP_API_BASE_URL=http://localhost:8081
