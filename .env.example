# WROS Monorepo - Environment Configuration
# Copy this file to .env and fill in actual values

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://app_user:<local-db-password>@localhost:5432/onboarding_prod

# ============================================
# BACKEND (Python FastAPI)
# ============================================
BACKEND_PORT=8080
BACKEND_HOST=0.0.0.0
BACKEND_ENV=development

# ============================================
# FRONTEND (React)
# ============================================
REACT_APP_API_BASE_URL=http://localhost:8080
FRONTEND_PORT=3000

# ============================================
# CAREERS SERVICE
# ============================================
CAREERS_PORT=5000

# ============================================
# SERVER CONFIGURATION (Production only)
# ============================================
SERVER_IP=46.224.149.7
PROD_PATH=/home/HRMS/WROS-Master

# ============================================
# JWT & SECURITY
# ============================================
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO

# Delivery-outcome webhooks (fail closed: 503 until set) -- app/core/delivery_webhook_auth.py
# Public URL prefix providers call, e.g. https://hrms.blitzenx.com/api
WEBHOOK_PUBLIC_BASE_URL=
# SendGrid Signed Event Webhook verification key (base64)
SENDGRID_WEBHOOK_PUBLIC_KEY=
# Mailgun HTTP webhook signing key (not the API key)
MAILGUN_WEBHOOK_SIGNING_KEY=
# Twilio account auth token
TWILIO_AUTH_TOKEN=
